<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Rhino 8 on Mac ships with the .NET 7 runtime.
      You can build with the .NET 10 SDK but must TARGET net7.0 so Rhino can load the assembly.
    -->
    <TargetFramework>net7.0</TargetFramework>
    <Platforms>x64</Platforms>
    <AssemblyName>AndArchitectGH</AssemblyName>
    <RootNamespace>AndArchitectGH</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Title>AND Architect – Grasshopper Floorplan Plugin</Title>
    <Description>Generative 3D floorplan design with AI assistance for Grasshopper / Rhino 8</Description>
    <Authors>AND Architect</Authors>
    <Version>1.1.0</Version>
    <!--
      Suppress the NU1701 "package was restored for a different framework" warning.
      The Grasshopper NuGet package targets .NETFramework but works fine under Rhino's
      .NET 7 runtime because Rhino provides the actual assemblies at load time.
    -->
    <NoWarn>NU1701</NoWarn>
  </PropertyGroup>

  <!-- Rename output to .gha so Grasshopper picks it up -->
  <Target Name="RenameToGha" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll"
          DestinationFiles="$(OutputPath)$(AssemblyName).gha"
          OverwriteReadOnlyFiles="true" />
  </Target>

  <ItemGroup>
    <!-- McNeel official NuGet packages for Rhino 8 -->
    <PackageReference Include="Grasshopper" Version="8.0.*" />

    <!--
      System.Drawing.Common provides Bitmap, Color, etc.
      On macOS, Rhino 8 ships its own cross-platform implementation of
      System.Drawing so this reference is only needed at COMPILE TIME.
      ExcludeAssets="runtime" tells NuGet not to copy it into the output
      folder – Rhino's own DLL takes over at runtime.
    -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.*"
                      ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
